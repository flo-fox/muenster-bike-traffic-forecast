# Secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code — personal settings and stray agent-worktree artifacts
.claude/settings.local.json
.claude/worktrees/

# Data files (raw downloads — regenerate from notebooks)
data/raw/*
!data/raw/.gitkeep

# Trained models (regenerate from notebooks), except the production model,
# which the Streamlit dashboard needs at deploy time and is committed
# directly (see notebook 18 / README).
models/*
!models/production_lightgbm.joblib

# Throwaway calibration/benchmark artifacts (notebook 16 Section 7-8's
# out-of-notebook hyperparameter sweep and reference pipeline dump) -
# never part of the tracked repo, regenerate as needed.
.scratch/
