# Local dry-run environment for scripts/send_daily_email.py.
# Copy to .env (gitignored) and fill in real values, or export these
# directly in your shell. NEVER commit real values here or anywhere else -
# in production these come from GitHub Actions secrets, not this file.

# Gmail address to send the daily report from.
GMAIL_ADDRESS=

# Gmail app-specific password for GMAIL_ADDRESS (not your normal password):
# https://support.google.com/accounts/answer/185833
GMAIL_APP_PASSWORD=

# Where the daily report is sent.
RECIPIENT_EMAIL=

# Anthropic API key for generating deviation explanations, from
# https://console.anthropic.com/ - a Claude Pro/Max subscription does not
# cover this; API usage is billed separately.
ANTHROPIC_API_KEY=
